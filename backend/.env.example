# Yerel (Docker'sız) geliştirme için şablon. Kopyalayıp `.env` olarak kaydedin:
#   cp .env.example .env
#
# DATABASE_URL, Docker Compose'un Postgres'i host'a map'lediği 5433 portunu
# hedefler (bkz. docker-compose.yml). Farklı bir yerel Postgres kullanıyorsanız
# bu değeri kendi bağlantınıza göre düzenleyin.

ENVIRONMENT=development
DEBUG=true
DATABASE_URL=postgresql+psycopg://formen:formen@localhost:5433/formen_takip
JWT_SECRET_KEY=dev-only-secret-change-in-production
CORS_ORIGINS=["http://localhost:5173"]
